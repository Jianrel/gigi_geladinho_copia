# Crie um arquivo .env na raiz do projeto (NUNCA commitado) com os valores reais.

# URL do Supabase ou Postgres local
DATABASE_URL=postgresql://usuario:senha@localhost:5432/gigi_estoque

# Segredo para assinar os tokens de login. Gere um valor forte e aleatório, ex:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Webhook do n8n usado para enviar o pedido do cliente via WhatsApp
N8N_WEBHOOK_URL=
N8N_USER=
N8N_PASS=

# Nome e subtítulo da loja (usado na interface)
NOME_LOJA=Gigi Geladinho
SUBTITULO_LOJA=Geladinhos Gourmet

# Número do WhatsApp para fallback de pedidos (com código do país, sem +)
WA_NUMERO=5563992657531

# Custo por unidade pago ao fornecedor (deixar vazio se não revende)
CUSTO_FORNECEDOR=
